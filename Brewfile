# Packages for these dotfiles. Install with: brew bundle --file=Brewfile

# editor and terminal config
brew "neovim"
brew "tmux"
brew "ripgrep"          # :grep in nvim (grepprg)
brew "lazygit"          # tmux popup (prefix g)

# python and lsp for nvim
brew "pyenv"            # zshrc
brew "basedpyright"     # python: completion, hover, types
brew "ruff"             # python: lint and format
brew "lua-language-server"
brew "python-lsp-server"

# shell and file tools
brew "git"
brew "gh"
brew "fzf"              # zshrc: fzf --zsh
brew "ranger"

# apps
cask "aerospace"
cask "ghostty"
