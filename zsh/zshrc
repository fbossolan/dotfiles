# functions
gpush() {
  branch=$(git branch --show-current)
  git push origin $branch
  echo "pushing to $branch"
}

gpull() {
  branch=$(git branch --show-current)
  git pull origin $branch
}

gdiff(){
    branch=$(git branch --show-current)
    git difftool origin/$branch
}

ftoken() {
